import getpass
import string
import hashlib
import secrets
import json
import os
import getpass
import datetime

account_locked = False
admin_code = "ADMIN_1234"
admin_code_hash = hashlib.sha256(admin_code.encode()).hexdigest()

while True:

     options = input("1. Register\n2. Login\n3. Unlock Account\nChoose an option: ")

     while options != "1" and options != "2" and options != "3":
         print("Invalid option. Please choose either 1, 2, or 3.")
         options = input("1. Register\n2. Login\n3. Unlock Account\nChoose an option: ")

     if options == "1": 
         print("Registration selected ")

         if os.path.exists("password_data.json"):
            print("An account is already registered. Please log in.")
            continue

         else:
           username = input("Enter a username: ")
           while True:
               password = getpass.getpass("enter a password:")
               password_bytes = password.encode()

               score = 0 

               length = len(password)
      
               if length >= 8:
                 print("password is at least 8 characters long")
                 score +=1
               else:
                 print("password is too short.")

               if any(character.isupper() for character in password):
                 print("password contains an uppercase letter")
                 score +=1
               else:
                 print("password should contain at least one uppercase letter")

               if any(character.islower() for character in password):
                 print("password contains a lowercase letter")
                 score +=1
               else:
                 print("password should contain at least one lowercase letter")
      
               if any(character.isdigit() for character in password):
                 print("password contains a digit")
                 score +=1
               else:
                 print("password should contain a digit")

               if any(character in string.punctuation for character in password):
                 print("password contains a special character")
                 score +=1
               else:
                 print("password should contain at least one special character")

               print("password score:", score, "/5")

               if score == 5:
                 print("Password is very strong")
               elif score == 4:
                 print("Password is strong")
               elif score == 3:
                 print("Password is medium")
               elif score == 2:
                 print("Password is weak")
               else:
                 print("Password is very weak")

               if score < 3:
                 print("Password is not strong enough. Please choose a stronger password.")
                 continue
               
               break
        
           salt = secrets.token_bytes(16)

           combined = password_bytes + salt

           password_hash = hashlib.sha256(combined).hexdigest()

           password_data = {
             "username": username,
             "salt": salt.hex(),
             "hash": password_hash,
             "account_locked": False, 
           }

           with open("password_data.json", "w") as file:
            json.dump(password_data, file)

           print("Registration successful.")

           with open("security_log.txt", "a") as log_file:
            log_file.write(
              str(datetime.datetime.now()) + " - User registered: " + username + "\n"
            )

           verify_password = getpass.getpass("re-enter your password:")
           verify_bytes = verify_password.encode()
           verify_combined = verify_bytes + salt
           verify_hash = hashlib.sha256(verify_combined).hexdigest()

           if verify_hash == password_hash:
              print("Password verified")
              print("welcome,",username)
              with open("security_log.txt", "a") as log_file:
                log_file.write(
                  str(datetime.datetime.now()) + " - User logged in: " + username + "\n"
                )
           else:
              print("Password verification failed. The passwords do not match.")


     elif options == "2":
          print("Login selected")

          if account_locked:
            print("Account is locked.")
            continue

          if not os.path.exists("password_data.json"):
            print("No account found. Please register first.")
            continue
       
       
          with open("password_data.json", "r") as file:
              saved_data = json.load(file)

          saved_username = saved_data["username"]
          saved_hash = saved_data["hash"]
          saved_salt = saved_data["salt"]
          saved_salt_bytes = bytes.fromhex(saved_salt)
          account_locked = saved_data.get("account_locked", False)

          if account_locked:
              print("Account is locked.")
              continue

          attempts = 3
          while attempts > 0:

             login_username = input("Enter your username: ")

             if login_username != saved_username:
                print("Username does not match. Please try again.")
                continue
             verify_password = getpass.getpass("re-enter the password :")
             verify_bytes = verify_password.encode()
             verify_combined = verify_bytes + saved_salt_bytes
             verify_hash = hashlib.sha256(verify_combined).hexdigest()

             if login_username == saved_username and verify_hash == saved_hash:
              print("Password verified")
              print("welcome,",saved_username)
             else:
              attempts -= 1
              print("Password verification failed.")
              print("Attempts remaining:", attempts)

              with open("security_log.txt", "a") as log_file:
                log_file.write(
                  str(datetime.datetime.now()) + " - Failed login attempt: " + login_username + "\n"
                )

              if attempts == 0:
                print("Maximum attempts reached. Login blocked.")
                account_locked = True
                saved_data["account_locked"] = True
                with open("security_log.txt", "a") as log_file:
                    log_file.write(
                        str(datetime.datetime.now()) + " - Account locked: " + login_username + "\n"
                    )
                with open("password_data.json", "w") as file:
                    json.dump(saved_data, file)
                break

     elif options == "3":
        if not os.path.exists("password_data.json"):
            print("No account found. Please register first.")
            continue

        with open("password_data.json", "r") as file:
            saved_data = json.load(file)

        account_locked = saved_data.get("account_locked", False)
        if not account_locked:
            print("Account is not locked.")
            continue
        else:
            print("Account is locked.")
            unlock_code = getpass.getpass("Enter the unlock code: ")
            unlock_code_hash = hashlib.sha256(unlock_code.encode()).hexdigest()

            if unlock_code_hash == admin_code_hash:
               account_locked = False
               saved_data["account_locked"] = False
               with open("password_data.json", "w") as file:
                   json.dump(saved_data, file)
               print("Account unlocked successfully.")
               with open("security_log.txt", "a") as log_file:
                log_file.write(
                  str(datetime.datetime.now()) + " - Account unlocked\n"
                )
            else:
               print("Incorrect unlock code.")
               continue




